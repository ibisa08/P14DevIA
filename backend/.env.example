# Connexion PostgreSQL. Port 5432 = valeur du README (docker run -p 5432:5432).
# Si 5432 est déjà pris sur ta machine (Postgres Homebrew, autre conteneur...),
# mappe le conteneur sur un autre port (ex. -p 5434:5432) et reporte-le ici dans ton .env.
DATABASE_URL=postgresql://user:password@localhost:5432/newsfoundry

# Port d'écoute de l'API (Railway injecte sa propre valeur de PORT)
PORT=8000

# Affiche les requêtes SQL dans les logs (true/false)
SQL_ECHO=false

# Origines autorisées par CORS, séparées par des virgules
FRONTEND_ORIGINS=http://localhost:3000

# Secret de signature des JWT (obligatoire, 32 caractères minimum, jamais commité).
# Générer avec : openssl rand -hex 32
JWT_SECRET=

# Durée de validité d'un token, en minutes
JWT_EXPIRE_MINUTES=60

# Modèle des agents IA (obligatoire), au format PydanticAI « fournisseur:modèle » :
# - test : TestModel de PydanticAI, réponses factices sans clé ni appel réseau (dev, CI)
# - anthropic:claude-haiku-5-5 : production (nécessite ANTHROPIC_API_KEY)
LLM_MODEL=test

# Clé API Anthropic, inutile avec LLM_MODEL=test (jamais commitée). Lue directement dans
# l'environnement par le SDK Anthropic : lancer l'API avec `uv run --env-file .env ...`
# en local, variable d'environnement sur Railway.
# ANTHROPIC_API_KEY=

# Clé WorldNewsAPI (optionnelle, jamais commitée). Sans elle, l'app fonctionne sans actualités :
# les discussions sont créées avec le prompt de base et la recherche d'articles est indisponible.
# Plan gratuit : 50 points/jour, 1 requête/s, 1 requête simultanée.
# WORLDNEWS_API_KEY=

# Pays et langue des actualités du jour injectées dans le prompt des discussions
NEWS_COUNTRY=fr
NEWS_LANGUAGE=fr

# Cache des actualités du jour, en secondes (1 h par défaut), et durée pendant laquelle un
# échec (quota, panne) est gardé avant de retenter l'appel (5 min par défaut)
TOP_NEWS_CACHE_TTL_SECONDS=3600
TOP_NEWS_FAILURE_TTL_SECONDS=300
