# Connexion PostgreSQL. Port 5432 = valeur du README (docker run -p 5432:5432).
# Si 5432 est déjà pris sur ta machine (Postgres Homebrew, autre conteneur...),
# mappe le conteneur sur un autre port (ex. -p 5434:5432) et reporte-le ici dans ton .env.
DATABASE_URL=postgresql://user:password@localhost:5432/newsfoundry

# Port d'écoute de l'API (Railway injecte sa propre valeur de PORT)
PORT=8000

# Affiche les requêtes SQL dans les logs (true/false)
SQL_ECHO=false

# Origines autorisées par CORS, séparées par des virgules
FRONTEND_ORIGINS=http://localhost:3000
